   EXCAVATALENTO
   Observatorio del Mercado Laboral de la Arqueologia
   Version 2.0
   ========================================================== */


/*==========================================================
PALETA CORPORATIVA
==========================================================*/

:root{

  /* Azul corporativo (logo) */
  --primary:#1E2294;

  /* Azul oscuro */
  --primary-dark:#171C73;

  /* Azul claro */
  --primary-light:#4E58C8;

  /* Fondo institucional */
  --background:#F2ECE2;

  /* Tarjetas */
  --surface:#FFFFFF;

  /* Bordes */
  --border:#DDD6CA;

  /* Texto */
  --text:#222222;

  --text-light:#666666;

  /* Sombras */
  --shadow:0 6px 18px rgba(0,0,0,.08);

  /* Radios */
  --radius:16px;

}


/*==========================================================
GENERAL
==========================================================*/

body{

  background:var(--background);

  color:var(--text);

  font-family:

    "Montserrat",
    "Inter",
    "Segoe UI",
    Arial,
    sans-serif;

  font-size:16px;

  line-height:1.7;

}


/*==========================================================
ENLACES
==========================================================*/

a{

  color:var(--primary);

  text-decoration:none;

}

a:hover{

  color:var(--primary-dark);

}


/*==========================================================
TITULOS
==========================================================*/

h1{

  color:var(--primary);

  font-weight:800;

  margin-bottom:.5rem;

}

h2{

  color:var(--primary);

  font-weight:700;

  margin-top:3rem;

  margin-bottom:1rem;

  border-bottom:3px solid var(--primary);

  padding-bottom:.4rem;

}

h3{

  color:var(--primary-dark);

  font-weight:600;

}


/*==========================================================
HERO
==========================================================*/

.hero{

  background:var(--background);

  text-align:center;

  padding:5rem 2rem;

}


.hero-logo{

  margin-bottom:1.5rem;

}


.hero-logo img{

  width:220px;

}


.hero h1{

  font-size:3rem;

  margin-bottom:.3rem;

}


.hero h2{

  border:none;

  margin-top:0;

  color:var(--text-light);

  font-weight:500;

}


.hero p{

  max-width:850px;

  margin:auto;

  color:var(--text-light);

}


.hero-stat{

  margin-top:2rem;

  font-size:1.15rem;

  font-weight:600;

}


/*==========================================================
BOTON PRINCIPAL
==========================================================*/

.btn-explorar{

  display:inline-block;

  margin-top:2rem;

  background:var(--primary);

  color:white !important;

  padding:.9rem 2.4rem;

  border-radius:999px;

  font-weight:700;

  transition:.25s;

}

.btn-explorar:hover{

  background:var(--primary-dark);

  transform:translateY(-2px);

}


/*==========================================================
KPI GRID
==========================================================*/

.kpi-grid{

  display:grid;

  grid-template-columns:repeat(auto-fit,minmax(230px,1fr));

  gap:25px;

  margin:3rem auto;

}


/*==========================================================
KPI CARD
==========================================================*/

.kpi-card{

  background:var(--surface);

  border-radius:var(--radius);

  padding:1.8rem;

  box-shadow:var(--shadow);

  border-top:5px solid var(--primary);

  transition:.25s;

}


.kpi-card:hover{

  transform:translateY(-5px);

}


.kpi-card h3{

  font-size:.9rem;

  color:var(--text-light);

  text-transform:uppercase;

  letter-spacing:.06em;

  margin-bottom:.6rem;

}


.kpi-card h1{

  font-size:2.4rem;

  color:var(--primary);

  margin:.2rem 0;

}


.kpi-card p{

  color:var(--text-light);

  margin-top:1rem;

}


/*==========================================================
COLUMNAS
==========================================================*/

.columns{

  margin-top:2rem;

  margin-bottom:2rem;

}


/*==========================================================
TABLAS
==========================================================*/

table{

  width:100%;

  border-collapse:collapse;

  margin-top:1rem;

  background:white;

}


table th{

  background:var(--primary);

  color:white;

  font-weight:600;

}


table td,
table th{

  padding:12px;

  border:1px solid var(--border);

}


/*==========================================================
CALLOUT
==========================================================*/

.callout-tip{

  border-left:6px solid var(--primary);

  background:white;

  border-radius:12px;

}


/*==========================================================
OBJETIVO
==========================================================*/

.objetivo{

  max-width:950px;

  margin:auto;

  padding:2rem;

  line-height:1.8;

}


/*==========================================================
SEPARADORES
==========================================================*/

hr{

  border:none;

  border-top:1px solid var(--border);

  margin:3rem 0;

}


/*==========================================================
FOOTER
==========================================================*/

footer{

  margin-top:5rem;

  text-align:center;

  color:var(--text-light);

  font-size:.9rem;

}


/*==========================================================
RESPONSIVE
==========================================================*/

@media(max-width:900px){

.hero{

padding:3rem 1rem;

}

.hero h1{

font-size:2rem;

}

.hero-logo img{

width:170px;

}

.kpi-grid{

grid-template-columns:1fr;

}

}


/*==========================================================
ANIMACIONES SUAVES
==========================================================*/

*{

transition:all .20s ease;

}